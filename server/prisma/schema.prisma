generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MARKETING
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  name       String
  role       UserRole    @default(OWNER)
  adAccounts AdAccount[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model AdAccount {
  id            String     @id @default(cuid())
  metaAccountId String     @unique
  name          String
  accessToken   String
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  campaigns     Campaign[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Campaign {
  id             String      @id @default(cuid())
  metaCampaignId String      @unique
  name           String
  status         String
  objective      String?
  adAccountId    String
  adAccount      AdAccount   @relation(fields: [adAccountId], references: [id])
  metrics        AdMetrics[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model AdMetrics {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  date        DateTime
  spend       Decimal  @db.Decimal(10, 2)
  impressions Int
  clicks      Int
  ctr         Decimal  @db.Decimal(6, 4)
  cpm         Decimal  @db.Decimal(10, 2)
  conversions Int      @default(0)
  roas        Decimal  @default(0) @db.Decimal(10, 4)
  createdAt   DateTime @default(now())

  @@unique([campaignId, date])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  sales     Sale[]
  quotes    Quote[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String              @unique
  description        String?
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  costPrice          Decimal             @db.Decimal(10, 2)
  sellPrice          Decimal             @db.Decimal(10, 2)
  supplier           String?
  line               String?
  imageName          String?
  imageType          String?
  imageData          String?             @db.Text
  stock              Int                 @default(0)
  stockMinAlert      Int                 @default(5)
  active             Boolean             @default(true)
  saleItems          SaleItem[]
  quoteItems         QuoteItem[]
  stockMovements     StockMovement[]
  priceHistory       PriceHistory[]
  materials          Material[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Sale {
  id            String     @id @default(cuid())
  saleNumber    String     @unique
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  notes         String?
  meliOrderId   String?    @unique
  fichaId       String?    @unique
  paymentMethod String?
  paymentStatus String     @default("PAID")
  pendingAmount Decimal?   @db.Decimal(10, 2)
  items         SaleItem[]
  totalCost     Decimal    @db.Decimal(10, 2)
  totalRevenue  Decimal    @db.Decimal(10, 2)
  totalProfit   Decimal    @db.Decimal(10, 2)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
}

model MeliToken {
  id           String   @id @default(cuid())
  meliUserId   String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  profit    Decimal @db.Decimal(10, 2)
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id])
  items       QuoteItem[]
  notes       String?
  validDays   Int         @default(15)
  status      QuoteStatus @default(DRAFT)
  totalAmount Decimal     @db.Decimal(10, 2)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Int
  reason    String?
  saleId    String?
  createdAt DateTime          @default(now())
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  oldPrice  Decimal  @db.Decimal(10, 2)
  newPrice  Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String              @unique
  supplier    String
  status      PurchaseOrderStatus @default(PENDING)
  notes       String?
  items       PurchaseOrderItem[]
  totalCost   Decimal             @db.Decimal(10, 2)
  expectedAt  DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String?
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  received        Int           @default(0)
}

enum PurchaseOrderStatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED
}

model GoogleAdsToken {
  id           String   @id @default(cuid())
  customerId   String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Expense {
  id            String    @id @default(cuid())
  date          DateTime
  concept       String
  amount        Decimal   @db.Decimal(12, 2)
  paymentSource String    @default("EFECTIVO_MP")
  expenseType   String    @default("EMPRESA")
  category      String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  role      String?
  active    Boolean  @default(true)
  planos    Plano[]
  createdAt DateTime @default(now())
}

model Plano {
  id         String    @id @default(cuid())
  title      String
  notes      String?
  fileName   String?
  fileType   String?
  fileData   String?   @db.Text
  status     String    @default("PENDIENTE")
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

model FichaPedido {
  id             String    @id @default(cuid())
  fichaNumber    String    @unique
  date           DateTime  @default(now())
  estimatedDate  DateTime?
  // Cliente
  clientName     String
  clientPhone    String?
  clientLocation String?
  // Pedido (items: [{ cantidad, producto }])
  items          Json      @default("[]")
  // Pago
  total          Decimal   @default(0) @db.Decimal(12, 2)
  deposit        Decimal   @default(0) @db.Decimal(12, 2)
  paymentMethod  String?
  // Entrega
  deliveryType   String?
  deliveryVia    String?
  destination    String?
  transportInfo  String?
  // Observaciones
  observations   String?
  // Control interno
  fabricatedAt   DateTime?
  fabricatedBy   String?
  packedAt       DateTime?
  packedBy       String?
  deliveredAt    DateTime?
  deliveredBy    String?
  payments       Payment[]
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Pagos parciales de una ficha (seña, cuotas, saldo final)
model Payment {
  id        String      @id @default(cuid())
  fichaId   String
  ficha     FichaPedido @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  amount    Decimal     @db.Decimal(12, 2)
  date      DateTime    @default(now())
  method    String?
  notes     String?
  createdAt DateTime    @default(now())

  @@index([fichaId])
}

// Materiales que lleva cada producto (para costo real de fabricación)
model Material {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal  @default(1) @db.Decimal(10, 2)
  unit      String?
  unitCost  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Archivos adjuntos (fichas, clientes)
model Attachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fileName   String
  fileType   String?
  fileData   String   @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Notas rápidas / pendientes del dueño
model Note {
  id        String   @id @default(cuid())
  content   String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
